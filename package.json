{
  "name": "the-maple-case",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && node scripts/verify-public-build.mjs",
    "film:dev": "node scripts/film.mjs dev -p 3100",
    "film:build": "node scripts/film.mjs build",
    "film:start": "node scripts/film.mjs start -p 3100",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "audit:content": "node scripts/audit-content.ts",
    "test": "node --test \"tests/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm test && npm run audit:content && npm run build"
  },
  "dependencies": {
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  }
}
